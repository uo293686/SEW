<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.uniovi.es" targetNamespace="http://www.uniovi.es" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xs:element name="circuito">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="name" />
				<xs:element ref="length" />
				<xs:element ref="width" />
				<xs:element ref="date" />
				<xs:element ref="hour" />
				<xs:element ref="laps" />
				<xs:element ref="location" />
				<xs:element ref="country" />
				<xs:element ref="sponsor" />
				<xs:element ref="references" />
				<xs:element ref="photos" />
				<xs:element ref="videos" />
				<xs:element ref="coordinates" />
				<xs:element ref="tramos" />
				<xs:element ref="winnerinfo" />
				<xs:element ref="qualified" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="name" type="xs:string" />
	<xs:element name="length">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:integer">
					<xs:attribute name="unit" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="width">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:double">
					<xs:attribute name="unit" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="date" type="xs:date" />
	<xs:element name="hour" type="xs:dateTime" />
	<xs:element name="laps" type="xs:integer" />
	<xs:element name="location" type="xs:string" />
	<xs:element name="country" type="xs:string" />
	<xs:element name="sponsor" type="xs:string" />
	<xs:element name="references">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="3" maxOccurs="unbounded" ref="reference" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="reference" type="xs:string" />
	<xs:element name="photos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="5" ref="photo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="photo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="phototitle" />
				<xs:element ref="imgfilename" />
				<xs:element ref="imgformat" />
				<xs:element ref="imgurl" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="phototitle" type="xs:string" />
	<xs:element name="imgfilename" type="xs:string" />
	<xs:element name="imgformat" type="xs:string" />
	<xs:element name="imgurl" type="xs:string" />
	<xs:element name="videos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="3" ref="video" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="video">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="videotitle" />
				<xs:element ref="filename" />
				<xs:element ref="format" />
				<xs:element ref="url" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="videotitle" type="xs:string" />
	<xs:element name="filename" type="xs:string" />
	<xs:element name="format" type="xs:string" />
	<xs:element name="url" type="xs:string" />
	<xs:element name="coordinates">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="latitud" />
				<xs:element ref="longitud" />
				<xs:element ref="height" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="latitud" type="xs:string" />
	<xs:element name="longitud" type="xs:string" />
	<xs:element name="height">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:integer">
					<xs:attribute name="unit" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="tramos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="tramo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tramo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="distance" />
				<xs:element ref="endcoords" />
				<xs:element ref="number" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="distance">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:integer">
					<xs:attribute name="unit" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="endcoords">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="endlatitud" />
				<xs:element ref="endlongitud" />
				<xs:element ref="endheight" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="endlatitud" type="xs:string" />
	<xs:element name="endlongitud" type="xs:string" />
	<xs:element name="endheight">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unit" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="number" type="xs:integer" />
	<xs:element name="winnerinfo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="winner" />
				<xs:element ref="time" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="winner" type="xs:string" />
	<xs:element name="time" type="xs:duration" />
	<xs:element name="qualified">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="3" ref="driver" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="driver" type="xs:string" />
</xs:schema>